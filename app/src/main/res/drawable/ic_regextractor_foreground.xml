        android:fillColor="#67E8F9"
        android:pathData="M57,52.5 H65 A2,2 0 0 1 65,55.5 H57 A2,2 0 0 1 57,52.5 Z" />

    <!-- lens rim -->
    <path
        android:strokeColor="#67E8F9"

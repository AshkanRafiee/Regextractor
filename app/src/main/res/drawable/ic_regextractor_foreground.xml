        android:pathData="M48,57 A13,13 0 1 0 74,57 A13,13 0 1 0 48,57 Z" />

    <!-- handle -->
    <path
        android:strokeColor="#67E8F9"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M69.5,65.5 L76.5,72.5" />

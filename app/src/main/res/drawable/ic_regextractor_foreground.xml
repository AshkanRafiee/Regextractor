<?xml version="1.0" encoding="utf-8"?>
<!-- Highlight lens: a magnifier finding a highlighted span inside sample text lines.
     All geometry stays inside the 66dp adaptive-icon safe zone (center 54,54 radius ~32). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- text lines -->
    <path
        android:fillColor="#334155"
        android:pathData="M32.5,36 H73.5 A2.5,2.5 0 0 1 73.5,41 H32.5 A2.5,2.5 0 0 1 32.5,36 Z" />
    <path
        android:fillColor="#334155"
        android:pathData="M32.5,51 H73.5 A2.5,2.5 0 0 1 73.5,56 H32.5 A2.5,2.5 0 0 1 32.5,51 Z" />
    <path
        android:fillColor="#334155"
        android:pathData="M32.5,66 H55.5 A2.5,2.5 0 0 1 55.5,71 H32.5 A2.5,2.5 0 0 1 32.5,66 Z" />

    <!-- highlighted span on the middle line -->
    <path
        android:fillColor="#22D3EE"
        android:pathData="M40.5,51 H59.5 A2.5,2.5 0 0 1 59.5,56 H40.5 A2.5,2.5 0 0 1 40.5,51 Z" />

    <!-- lens glass -->
    <path
        android:fillColor="#101C30"
        android:pathData="M48,57 A13,13 0 1 0 74,57 A13,13 0 1 0 48,57 Z" />

    <!-- the match, seen through the glass -->

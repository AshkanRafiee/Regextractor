<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- android:windowLightNavigationBar requires API 27; minSdk is 26, so
         this override only applies on devices that actually support it. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#67E8F9</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0B1220</item>
        <item name="android:navigationBarColor">#080D16</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorControlActivated">#67E8F9</item>
    </style>
</resources>
